{
  "name": "visor-ai",
  "version": "0.2.12",
  "description": "Verified mobile app interaction, semantic navigation, and evidence capture for AI coding agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleksKapera/visor"
  },
  "homepage": "https://www.visorai.dev/docs",
  "bugs": {
    "url": "https://github.com/AleksKapera/visor/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "bin": {
    "visor": "./dist/main.js"
  },
  "files": [
    "dist",
    "docs/agents/navigator",
    "docs/skills/visor-discovery",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:e2e:local": "node scripts/local-e2e.mjs",
    "check": "npm run build && npm run test",
    "verify": "npm run build && npm run test && npm run test:e2e:local",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "appium",
    "mobile",
    "automation",
    "testing",
    "e2e",
    "webdriverio",
    "ios",
    "android",
    "cli"
  ],
  "dependencies": {
    "appium": "^3.5.2",
    "webdriverio": "^9.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "appium-uiautomator2-driver": "^8.1.0",
    "appium-xcuitest-driver": "^11.17.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
